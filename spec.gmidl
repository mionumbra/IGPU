[gml_api]
module IGPU;

// ============================================================================
// IGPU - Advanced GPU access for GameMaker
//
// GameMaker owns the D3D11 device. IGPU borrows it: GML reads the device,
// immediate context and swapchain pointers from os_get_info() and hands them
// to igpu_init(). Everything else in IGPU operates on those borrowed handles.
//
// ---------------------------------------------------------------------------
// CROSS-PLATFORM CONTRACT (read before adding APIs)
// ---------------------------------------------------------------------------
// Only Windows and Xbox expose real device pointers; every other platform
// gives us driver strings at best, and HTML5/Switch return -1 outright.
// IGPU is therefore layered:
//
//   Tier 1  real GPU backend        Windows (D3D11), Xbox (D3D12, interface
//                                   reserved but not implemented)
//   Tier 2  query / reflection      adapter info, format support
//   Tier 3  capability abstraction  pure GML, works on EVERY platform
//
// Two rules keep this honest:
//
//   1. NO BACKEND TERMINOLOGY IN THIS FILE. No "d3d", "dxgi", "hlsl", "glsl",
//      "_5_0", "ID3D". If a caller has to know which API is underneath, the
//      abstraction has failed. The one deliberate exception is the optional
//      `dialect` hint on igpu_shader_compile, which exists precisely so that
//      callers who DO want to be specific can be, without forcing everyone.
//
//   2. REUSE GAMEMAKER'S OWN VOCABULARY. GameMaker already exposes a
//      platform-neutral GPU vocabulary (surface_rgba8unorm, vertex_usage_*,
//      cmpfunc_*, cull_*) that works on every backend it supports - those
//      names are DXGI-flavoured but the *semantics* are universal, because
//      GameMaker translates them per backend. Mirror that precedent instead
//      of inventing parallel names.
//
// Every capability that is not universally available must be queryable via
// igpu_get_capabilities() / igpu_supports(), so callers can degrade instead
// of crashing. APIs on unsupported platforms must FAIL CLEANLY (return 0 /
// false and set an error), never fault.
// ============================================================================

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

[global, bind = typed_gml]
function igpu_init(device : gmval, context : gmval, swapchain : gmval) : bool;

[global, bind = typed_gml]
function igpu_shutdown() : unit;

[global, bind = typed_gml]
function igpu_version() : string;

[global, bind = typed_gml]
function igpu_is_available() : bool;

// ---------------------------------------------------------------------------
// Device info
// ---------------------------------------------------------------------------

// NOTE: returns an IgpuFeatureLevel. Direct3D-specific today; on backends that
// have no equivalent concept this reports Unknown rather than lying. Callers
// that need a cross-platform answer should prefer igpu_get_capabilities().
[global, bind = typed_gml]
function igpu_get_feature_level() : int32;

// Empty string when the platform does not report an adapter description
// (Xbox, for one, returns "" by design).
[global, bind = typed_gml]
function igpu_get_adapter_description() : string;

// 0 when the platform does not expose video memory (Xbox returns 0).
[global, bind = typed_gml]
function igpu_get_video_memory() : int64;

[global, bind = typed_gml]
function igpu_get_backbuffer_width() : int32;

[global, bind = typed_gml]
function igpu_get_backbuffer_height() : int32;

// ---------------------------------------------------------------------------
// Capability query (Tier 3) - the mechanism that makes cross-platform viable
// ---------------------------------------------------------------------------

// Returns a struct describing what this backend can actually do. Never fails:
// on a platform with no native backend it returns an all-false structure, so
// callers degrade instead of crashing.
[global, bind = typed_gml]
function igpu_get_capabilities() : gmval;

// Convenience predicate over igpu_get_capabilities(). Pass an IgpuCapability.
[global, bind = typed_gml]
function igpu_supports(capability : int32) : bool;

// Native shader language of the active backend: "hlsl", "glsl", "glsl_es",
// "msl", "spirv", or "" when there is no backend.
[global, bind = typed_gml]
function igpu_get_shader_dialect() : string;

// ---------------------------------------------------------------------------
// Runtime shader compilation
// ---------------------------------------------------------------------------

// Unified entry point. `stage` is backend-neutral; `dialect` is an OPTIONAL
// hint and should normally be left empty, in which case the backend picks the
// right profile for the stage.
//
// Returns a shader handle, or 0 on failure (see igpu_get_last_error()).
[global, bind = typed_gml]
function igpu_shader_compile(source : string, entry : string, stage : int32, [type_hint = `string`] dialect) : int64;

// Convenience wrappers over igpu_shader_compile(). Kept because they read
// better at call sites and cost nothing; they carry no backend assumptions.
[global, bind = typed_gml]
function igpu_shader_compile_vertex(source : string, entry : string, [type_hint = `string`] dialect) : int64;

[global, bind = typed_gml]
function igpu_shader_compile_pixel(source : string, entry : string, [type_hint = `string`] dialect) : int64;

[global, bind = typed_gml]
function igpu_shader_compile_compute(source : string, entry : string, [type_hint = `string`] dialect) : int64;

[global, bind = typed_gml]
function igpu_shader_release([type_hint = `uint64`] shader) : bool;

[global, bind = typed_gml]
function igpu_get_last_error() : string;

// ---------------------------------------------------------------------------
// Input layout
// ---------------------------------------------------------------------------

// Creates an input layout describing how vertex data is laid out in a buffer,
// so a compiled vertex shader can actually be bound and drawn with.
//
// A layout is built from a vertex format that the CALLER describes using
// GameMaker's own vertex_usage_* / vertex_type_* vocabulary, exactly as
// vertex_format_begin() + vertex_format_add_* do at the GML level. IGPU does
// not invent parallel names, and no backend term appears here.
//
// `usage` and `type` accept the GameMaker constants directly:
//
//     usage : vertex_usage_position / _normal / _colour / _texcoord / _tangent
//             / _binormal / _blendweight / _blendindices / _psize
//     type  : vertex_type_float1 / _float2 / _float3 / _float4
//             / _colour / _ubyte4
//
// The first `element_count` entries of the two arrays are read pairwise:
// usage[i] and type[i] describe one element. The semantic index (the N in
// TEXCOORDn) is assigned automatically in first-seen order per usage, which
// matches how GameMaker's own formats are numbered.
//
// `shader` must be a vertex shader handle from igpu_shader_compile; it
// supplies the input signature the layout is validated against.
//
// `element_count` is how many entries to read from the arrays.
//
// `stride` is the size in bytes of one whole vertex. It is validated (a stride
// smaller than the declared elements is rejected) but not stored on the layout,
// because the vertex stride is supplied when the buffer is bound at draw time.
// Pass 0, or any negative value (which is what the GML helper's default of -1
// sends), to mean "tightly packed" - the elements are then assumed contiguous.
//
// Returns a layout handle, or 0 on failure (see igpu_get_last_error()).
[global, bind = typed_gml]
function igpu_input_layout_create(shader : int64, usage : array, type : array, [type_hint = `int32`] element_count, [type_hint = `int32`] stride) : int64;

[global, bind = typed_gml]
function igpu_input_layout_release([type_hint = `uint64`] layout) : bool;

// ---------------------------------------------------------------------------
// Buffers
// ---------------------------------------------------------------------------

// Creates a GPU buffer of `size` bytes.
//
// `usage` is a backend-neutral description of how often the contents change,
// NOT a memory-placement hint: the backend picks the right placement for it.
//
//     IgpuBufferUsage.Static   written once, drawn many times   (upload)
//     IgpuBufferUsage.Dynamic  rewritten every frame            (dynamic)
//     IgpuBufferUsage.Staging  readable back from the GPU on the CPU
//
// `bind` is a combination (bitwise OR) of IgpuBufferBind flags:
//
//     IgpuBufferBind.Vertex  / .Index     geometry a draw call consumes
//     IgpuBufferBind.Uniform              a shader constant block
//     IgpuBufferBind.Storage              a structured / raw shader resource
//
// Returns a buffer handle, or 0 on failure (see igpu_get_last_error()).
[global, bind = typed_gml]
function igpu_buffer_create(size : int64, usage : int32, bind : int32) : int64;

// Uploads bytes from a GameMaker buffer into `buffer`, starting `offset` bytes
// into it.
//
// `data` is a GameMaker buffer (create it with buffer_create and fill it with
// buffer_write / buffer_poke). GMIDL marshals it as raw memory that carries its
// OWN length, so there is no separate size argument to get out of sync with the
// real allocation - the copy is bounded by the buffer's actual length.
//
// The whole of `data` is copied. To upload a slice, create a buffer of the
// desired size or use buffer_copy first.
//
// Returns false if the source would run past the end of the destination, so a
// short buffer is caught here rather than corrupting neighbouring GPU memory.
[global, bind = typed_gml]
function igpu_buffer_write([type_hint = `uint64`] buffer, offset : int64, [type_hint = `buffer`] data) : bool;

// Resizes a buffer to `size` bytes, preserving as much existing content as the
// backend can. Only valid for buffers created with IgpuBufferUsage.Dynamic.
[global, bind = typed_gml]
function igpu_buffer_resize([type_hint = `uint64`] buffer, size : int64) : bool;

// Reads `size` bytes from `offset` in `buffer` back into the GameMaker buffer
// `dest`. Only valid for buffers created with IgpuBufferUsage.Staging; the
// backend reports an error otherwise rather than returning undefined memory.
//
// As with igpu_buffer_write, `dest` carries its own length and the copy never
// writes past it.
[global, bind = typed_gml]
function igpu_buffer_read([type_hint = `uint64`] buffer, offset : int64, [type_hint = `buffer`] dest) : bool;

[global, bind = typed_gml]
function igpu_buffer_size([type_hint = `uint64`] buffer) : int64;

[global, bind = typed_gml]
function igpu_buffer_release([type_hint = `uint64`] buffer) : bool;

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

[global, bind = typed_gml]
enum IgpuFeatureLevel
{
    Unknown = 0,
    Level_11_0 = 1,
    Level_11_1 = 2,
    Level_12_0 = 3,
    Level_12_1 = 4
}

// Shader stages are a backend-neutral concept: every graphics API has a
// vertex and a fragment/pixel stage. The later entries are declared so the
// interface does not have to change when a backend that supports them is
// added - query igpu_supports() before use, do not assume.
//
//   D3D11 (Windows)  Vertex, Pixel, Geometry, Hull, Domain
//   D3D12 (Xbox)     all of the above plus Mesh, Amplification
//   OpenGL           Vertex, Pixel, Geometry, Hull(=tess control), Domain
//   Vulkan/Metal     all of the above (Hull=tesc, Domain=tese)
//   WebGL / GLES     Vertex, Pixel only
[global, bind = typed_gml]
enum IgpuShaderStage
{
    Vertex = 0,
    Pixel = 1,
    Compute = 2,
    Geometry = 3,
    Hull = 4,
    Domain = 5,
    Mesh = 6,
    Amplification = 7
}

// How often a buffer's contents change. This is deliberately NOT GameMaker's
// buffer_fixed / buffer_grow / buffer_wrap: those describe a CPU buffer's
// size-growth policy, whereas this describes how the GPU will be asked to
// store the data. Reusing the GM names here would silently mean something
// different, so these are separate.
//
// The backend translates these into its own memory-placement terms; callers
// never see them.
[global, bind = typed_gml]
enum IgpuBufferUsage
{
    // Written once at creation, then only read by the GPU. The backend is free
    // to place this in the fastest memory it has.
    Static = 0,

    // Rewritten frequently. Correct for anything updated every frame; the
    // backend keeps it CPU-writable.
    Dynamic = 1,

    // Readable back by the CPU. Never usable directly by a draw call, and read
    // back with igpu_buffer_read().
    Staging = 2
}

// What a buffer is allowed to be used for. Combine with bitwise OR, e.g.
// IgpuBufferBind.Vertex | IgpuBufferBind.Index for a shared geometry buffer.
//
// These are capability-deciding bits, so they are validated at creation: a
// buffer that claims a use the backend cannot honour fails loudly instead of
// producing a draw that silently renders nothing.
[global, bind = typed_gml]
enum IgpuBufferBind
{
    None = 0,
    Vertex = 1,
    Index = 2,
    Uniform = 4,
    Storage = 8
}

// Backend-neutral feature flags for igpu_supports(). Values are stable and
// must not be renumbered once shipped.
[global, bind = typed_gml]
enum IgpuCapability
{
    None = 0,

    // Shader compilation and stages
    ShaderCompileRuntime = 1,
    ShaderStageVertex = 2,
    ShaderStagePixel = 3,
    ShaderStageCompute = 4,
    ShaderStageGeometry = 5,
    ShaderStageTessellation = 6,
    ShaderStageMesh = 7,

    // Resources
    Texture3D = 20,
    TextureArray = 21,
    TextureCubemap = 22,
    StructuredBuffer = 23,
    UnorderedAccess = 24,
    MultipleRenderTargets = 25,

    // Pipeline features
    Instancing = 40,
    IndirectDraw = 41,
    Queries = 42,
    Timestamps = 43,
    OcclusionQuery = 44,
    Fence = 45,
    Wireframe = 46,

    // Geometry submission
    InputLayout = 47,
    VertexBuffer = 48,
    IndexBuffer = 49,
    UniformBuffer = 50,
    // Buffer update strategies, queried so callers can pick one that works
    BufferResize = 51,
    BufferReadback = 52,

    // Platform info availability
    AdapterInfo = 60,
    VideoMemory = 61,
    BackbufferSize = 62
}
