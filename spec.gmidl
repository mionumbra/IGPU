[gml_api]
module IGPU;

// ============================================================================
// IGPU - Advanced GPU access for GameMaker
//
// GameMaker owns the D3D11 device. IGPU borrows it: GML reads the device,
// immediate context and swapchain pointers from os_get_info() and hands them
// to igpu_init(). Everything else in IGPU operates on those borrowed handles.
//
// ---------------------------------------------------------------------------
// CROSS-PLATFORM CONTRACT (read before adding APIs)
// ---------------------------------------------------------------------------
// Only Windows and Xbox expose real device pointers; every other platform
// gives us driver strings at best, and HTML5/Switch return -1 outright.
// IGPU is therefore layered:
//
//   Tier 1  real GPU backend        Windows (D3D11), Xbox (D3D12, interface
//                                   reserved but not implemented)
//   Tier 2  query / reflection      adapter info, format support
//   Tier 3  capability abstraction  pure GML, works on EVERY platform
//
// Two rules keep this honest:
//
//   1. NO BACKEND TERMINOLOGY IN THIS FILE. No "d3d", "dxgi", "hlsl", "glsl",
//      "_5_0", "ID3D". If a caller has to know which API is underneath, the
//      abstraction has failed. The one deliberate exception is the optional
//      `dialect` hint on igpu_shader_compile, which exists precisely so that
//      callers who DO want to be specific can be, without forcing everyone.
//
//   2. REUSE GAMEMAKER'S OWN VOCABULARY. GameMaker already exposes a
//      platform-neutral GPU vocabulary (surface_rgba8unorm, vertex_usage_*,
//      cmpfunc_*, cull_*) that works on every backend it supports - those
//      names are DXGI-flavoured but the *semantics* are universal, because
//      GameMaker translates them per backend. Mirror that precedent instead
//      of inventing parallel names.
//
// Every capability that is not universally available must be queryable via
// igpu_get_capabilities() / igpu_supports(), so callers can degrade instead
// of crashing. APIs on unsupported platforms must FAIL CLEANLY (return 0 /
// false and set an error), never fault.
// ============================================================================

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

[global, bind = typed_gml]
function igpu_init(device : gmval, context : gmval, swapchain : gmval) : bool;

// Binds the OpenGL context that is already current on this thread.
// Does not create a context, does not destroy one, and does not accept
// device pointers. A build without an OpenGL backend returns false and
// sets an error. It must not drop a device already bound with igpu_init.
[global, bind = typed_gml]
function igpu_bind_current() : bool;

[global, bind = typed_gml]
function igpu_shutdown() : unit;

[global, bind = typed_gml]
function igpu_version() : string;

[global, bind = typed_gml]
function igpu_is_available() : bool;

// True after the borrowed graphics device has been removed or reset.
// IGPU drops that device when it notices: later calls fail until igpu_init()
// is given the new pointers, and handles created on the old device are gone.
// A clean igpu_shutdown() is not loss. False when no device was ever bound.
[global, bind = typed_gml]
function igpu_device_lost() : bool;

// ---------------------------------------------------------------------------
// Device info
// ---------------------------------------------------------------------------

// NOTE: returns an IgpuFeatureLevel. Direct3D-specific today; on backends that
// have no equivalent concept this reports Unknown rather than lying. Callers
// that need a cross-platform answer should prefer igpu_get_capabilities().
[global, bind = typed_gml]
function igpu_get_feature_level() : int32;

// Empty string when the platform does not report an adapter description
// (Xbox, for one, returns "" by design).
[global, bind = typed_gml]
function igpu_get_adapter_description() : string;

// 0 when the platform does not expose video memory (Xbox returns 0).
[global, bind = typed_gml]
function igpu_get_video_memory() : int64;

[global, bind = typed_gml]
function igpu_get_backbuffer_width() : int32;

[global, bind = typed_gml]
function igpu_get_backbuffer_height() : int32;

// ---------------------------------------------------------------------------
// Capability query (Tier 3) - the mechanism that makes cross-platform viable
// ---------------------------------------------------------------------------

// Returns a struct describing what this backend can actually do. Never fails:
// on a platform with no native backend it returns an all-false structure, so
// callers degrade instead of crashing.
[global, bind = typed_gml]
function igpu_get_capabilities() : gmval;

// Convenience predicate over igpu_get_capabilities(). Pass an IgpuCapability.
[global, bind = typed_gml]
function igpu_supports(capability : int32) : bool;

// Native shader language of the active backend: "hlsl", "glsl", "glsl_es",
// "msl", "spirv", or "" when there is no backend.
[global, bind = typed_gml]
function igpu_get_shader_dialect() : string;

// Records the graphics strings GameMaker returns from os_get_info() on
// platforms that do not hand over a device (gl_vendor_string / GL_VENDOR,
// gl_version_string / GL_VERSION, the renderer string, the shading-language
// string, and GL_MAX_TEXTURE_SIZE). An empty version clears the note.
//
// This does not enable drawing or shader compilation. While a device is
// bound, igpu_get_capabilities() keeps reporting that device.
[global, bind = typed_gml]
function igpu_set_graphics_info(vendor : string, version : string, renderer : string, shading_language : string, max_texture_size : int32) : bool;

// ---------------------------------------------------------------------------
// Runtime shader compilation
// ---------------------------------------------------------------------------

// Unified entry point. `stage` is backend-neutral; `dialect` is an OPTIONAL
// hint and should normally be left empty, in which case the backend picks the
// right profile for the stage.
//
// Returns a shader handle, or 0 on failure (see igpu_get_last_error()).
[global, bind = typed_gml]
function igpu_shader_compile(source : string, entry : string, stage : int32, [type_hint = `string`] dialect) : int64;

[global, bind = typed_gml]
function igpu_shader_release([type_hint = `uint64`] shader) : bool;

// Binds a compiled shader to `stage` for subsequent igpu_draw calls.
//
// WHY THIS EXISTS: igpu_draw's header used to say "the caller is responsible for
// having set a shader", but there was no way to do that - the handles returned
// by igpu_shader_compile are IGPU's own and cannot be passed to GameMaker's
// shader_set(). So a draw ran against whatever shader GameMaker happened to have
// bound, and "igpu_draw returned true" proved only that the call was issued.
// This function is the missing half of that contract.
//
// NO AUTOMATIC RESTORE, BY DESIGN - unlike the input-assembler state, which
// igpu_draw saves and restores around each call. The shader is a caller-chosen
// setting rather than a side effect of drawing: rebinding GameMaker's shader
// after every IGPU draw would fight any deliberate shader switch the caller
// made, and there is no GML-level way to read what was bound before. So the
// binding is sticky until changed, and `shader` = 0 unbinds explicitly.
//
// This DOES mean an IGPU shader can be silently replaced by GameMaker's own
// drawing, because the backend re-binds its shader on every one of its draws.
// Bind immediately before the igpu_draw calls that need it, and query
// igpu_get_bound_shader() if you need to know whether it is still yours.
//
// The stage must match the stage the handle was compiled for; binding a pixel
// shader to the vertex stage fails with an error rather than silently doing
// nothing. Requires a bound device, so call igpu_init() first.
[global, bind = typed_gml]
function igpu_shader_bind(shader : int64, stage : int32) : bool;

// Reports which IGPU shader handle is currently bound to `stage`, or 0 if none
// is. This is IGPU's own bookkeeping, NOT a read-back from the device: another
// extension, or GameMaker's own drawing, can change the real binding without
// IGPU knowing. It answers "is my binding still the one I set", which is what a
// caller can actually act on.
[global, bind = typed_gml]
function igpu_get_bound_shader(stage : int32) : int64;

[global, bind = typed_gml]
function igpu_get_last_error() : string;

// ---------------------------------------------------------------------------
// Input layout
// ---------------------------------------------------------------------------

// Creates an input layout describing how vertex data is laid out in a buffer,
// so a compiled vertex shader can actually be bound and drawn with.
//
// A layout is built from a vertex format that the CALLER describes using
// GameMaker's own vertex_usage_* / vertex_type_* vocabulary, exactly as
// vertex_format_begin() + vertex_format_add_* do at the GML level. IGPU does
// not invent parallel names, and no backend term appears here.
//
// `usage` and `type` accept the GameMaker constants directly:
//
//     usage : vertex_usage_position / _normal / _colour / _texcoord / _tangent
//             / _binormal / _blendweight / _blendindices / _psize
//     type  : vertex_type_float1 / _float2 / _float3 / _float4
//             / _colour / _ubyte4
//
// The first `element_count` entries of the two arrays are read pairwise:
// usage[i] and type[i] describe one element. The semantic index (the N in
// TEXCOORDn) is assigned automatically in first-seen order per usage, which
// matches how GameMaker's own formats are numbered.
//
// `shader` must be a vertex shader handle from igpu_shader_compile; it
// supplies the input signature the layout is validated against.
//
// `element_count` is how many entries to read from the arrays.
//
// `step[i]` is IgpuVertexStep. Vertex advances once per vertex. Instance
// advances once per copy. `vertex_stride` and `instance_stride` of 0 or a
// negative value mean tightly packed. An element list with no Instance steps
// passes 0 for instance_stride. `step` must have `element_count` entries.
//
// Returns a layout handle, or 0 on failure (see igpu_get_last_error()).
[global, bind = typed_gml]
enum IgpuVertexStep
{
    Vertex = 0,
    Instance = 1
}

[global, bind = typed_gml]
function igpu_input_layout_create(shader : int64, usage : array, type : array, step : array, [type_hint = `int32`] element_count, [type_hint = `int32`] vertex_stride, [type_hint = `int32`] instance_stride) : int64;

[global, bind = typed_gml]
function igpu_input_layout_release([type_hint = `uint64`] layout) : bool;

// ---------------------------------------------------------------------------
// Buffers
// ---------------------------------------------------------------------------

// Creates a GPU buffer of `size` bytes.
//
// `usage` is a backend-neutral description of how often the contents change,
// NOT a memory-placement hint: the backend picks the right placement for it.
//
//     IgpuBufferUsage.Static   written once, drawn many times   (upload)
//     IgpuBufferUsage.Dynamic  rewritten every frame            (dynamic)
//     IgpuBufferUsage.Staging  readable back from the GPU on the CPU
//
// `bind` is a combination (bitwise OR) of IgpuBufferBind flags:
//
//     IgpuBufferBind.Vertex  / .Index     geometry a draw call consumes
//     IgpuBufferBind.Uniform              a shader constant block
//     IgpuBufferBind.Storage              a structured / raw shader resource
//
// Returns a buffer handle, or 0 on failure (see igpu_get_last_error()).
//
// `stride` is the size in bytes of one record. A vertex buffer needs it so a
// draw can count vertices. A storage buffer needs it as the structure size
// (a multiple of 4, from 4 to 2048) and `size` must be a whole number of
// records. Pass 0 for every other bind. It is not the stride checked by
// igpu_input_layout_create.
[global, bind = typed_gml]
function igpu_buffer_create(size : int64, usage : int32, bind : int32, [type_hint = `int32`] stride) : int64;

// Uploads bytes from a GameMaker buffer into `buffer`, starting `offset` bytes
// into it.
//
// `data` is a GameMaker buffer (create it with buffer_create and fill it with
// buffer_write / buffer_poke). GMIDL marshals it as raw memory that carries its
// OWN length, so there is no separate size argument to get out of sync with the
// real allocation - the copy is bounded by the buffer's actual length.
//
// The whole of `data` is copied. To upload a slice, create a buffer of the
// desired size or use buffer_copy first.
//
// Returns false if the source would run past the end of the destination, so a
// short buffer is caught here rather than corrupting neighbouring GPU memory.
[global, bind = typed_gml]
function igpu_buffer_write([type_hint = `uint64`] buffer, offset : int64, [type_hint = `buffer`] data) : bool;

// Resizes a buffer to `size` bytes, preserving as much existing content as the
// backend can. Only valid for buffers created with IgpuBufferUsage.Dynamic.
[global, bind = typed_gml]
function igpu_buffer_resize([type_hint = `uint64`] buffer, size : int64) : bool;

// Reads `size` bytes from `offset` in `buffer` back into the GameMaker buffer
// `dest`. Only valid for buffers created with IgpuBufferUsage.Staging; the
// backend reports an error otherwise rather than returning undefined memory.
//
// As with igpu_buffer_write, `dest` carries its own length and the copy never
// writes past it.
[global, bind = typed_gml]
function igpu_buffer_read([type_hint = `uint64`] buffer, offset : int64, [type_hint = `buffer`] dest) : bool;

[global, bind = typed_gml]
function igpu_buffer_size([type_hint = `uint64`] buffer) : int64;

[global, bind = typed_gml]
function igpu_buffer_release([type_hint = `uint64`] buffer) : bool;

// Binds a storage buffer for shader reads at `slot` on `stage`. Pass buffer 0
// to put back whatever was bound there before the first bind. GameMaker may
// not replace a vertex-shader resource slot on its next draw, so unbind
// before returning to it.
[global, bind = typed_gml]
function igpu_storage_bind([type_hint = `uint64`] buffer, stage : int32, slot : int32) : bool;

// ---------------------------------------------------------------------------
// Uniform blocks
// ---------------------------------------------------------------------------
//
// A compiled shader's constant blocks (HLSL cbuffer, GLSL uniform block, a
// Metal/Vulkan uniform buffer) are read back from the compiled shader. Callers
// name a block and a member; they do not supply byte offsets or packing rules.
//
// The numbers are the backend's own packing. A float3 followed by a float2
// does not sit on a tightly packed byte stream, and the gap is not something
// the caller calculates.
//
// `igpu_uniform_write` stores one member into a uniform buffer. The buffer
// must have been created with IgpuBufferBind.Uniform and be at least as large
// as the block (`IgpuUniformBlock.size`). Values are a flat array of numbers:
//
//     scalar     one number
//     vector     one number per component (a float4 is 4)
//     matrix     column-major, one number per element (a float4x4 is 16)
//     array      that many numbers, repeated per element
//
// Bool members are 0 or 1. Integer members are written as 32-bit values.
// Writing a whole struct fails; write the fields the reflection lists.
//
// `igpu_uniform_bind` attaches the buffer to a stage slot for later draws.
// `IgpuUniformBlock.slot` is the slot the shader asked for. Pass buffer 0 to
// put back whatever was bound there before the first bind on that slot.
// GameMaker does not rebind its constant buffers on every draw, so leaving
// one of its slots replaced changes its next draw. Bind, draw, then pass 0.

// Scalar kind of a uniform member. The shape is rows/columns/elements, not a
// separate enum: a float is 1x1, a float4 is 1x4, a float4x4 is 4x4.
[global, bind = typed_gml]
enum IgpuUniformType
{
    Float = 0,
    Int = 1,
    Uint = 2,
    Bool = 3,
    Struct = 4,
    Unknown = 5
}

// One member of a uniform block. `type` is IgpuUniformType. A float is 1x1,
// a float4 is 1x4, a float4x4 is 4x4. `elements` is 0 when the member is not
// an array. Fields are concrete types so the generator emits a readable struct.
[global]
class `[[IgpuUniformMember]]` prototype Object
{
    [field]
    property name : string { get; set; }

    [field]
    property offset : int32 { get; set; }

    [field]
    property size : int32 { get; set; }

    [field]
    property type : int32 { get; set; }

    [field]
    property rows : int32 { get; set; }

    [field]
    property columns : int32 { get; set; }

    [field]
    property elements : int32 { get; set; }
}

// One constant block. `slot` is -1 when the shader did not request one.
[global]
class `[[IgpuUniformBlock]]` prototype Object
{
    [field]
    property name : string { get; set; }

    [field]
    property size : int32 { get; set; }

    [field]
    property slot : int32 { get; set; }

    [field, type_hint = `IgpuUniformMember[]`]
    property members : gmval { get; set; }
}

// Empty array when the shader has no blocks and the last error is empty.
// Empty array and a non-empty error when the handle is unknown.
[global, bind = typed_gml, type_hint = `IgpuUniformBlock[]`]
function igpu_shader_reflect(shader : int64) : gmval;

[global, bind = typed_gml]
function igpu_uniform_write([type_hint = `uint64`] buffer, shader : int64, block : string, member : string, values : array) : bool;

// buffer 0 restores the slot. The binding stays until then, including across
// igpu_draw calls.
[global, bind = typed_gml]
function igpu_uniform_bind([type_hint = `uint64`] buffer, stage : int32, slot : int32) : bool;

// ---------------------------------------------------------------------------
// Drawing
// ---------------------------------------------------------------------------

// Binds a vertex buffer and its input layout, then issues a draw call.
//
// This is deliberately ONE function rather than a bind-then-draw pair.
// GameMaker's GML state functions do not read or write input-assembler state
// (the save table is blend, depth, stencil, cull, fog, colour write, alpha
// test and samplers), so a caller cannot put that state back. IGPU reads it
// from the device and restores it before returning.
//
// GameMaker's own draws already rebind the vertex buffer, input layout and
// topology, and do not cache them. The restore is not what keeps the next
// sprite off IGPU's buffer. It puts back the index buffer, which GameMaker
// never rebinds, and it leaves the device consistent for anything that reads
// the assembler before GameMaker's next draw. If GameMaker later caches
// assembler state, the restore becomes load-bearing.
//
// `primitive` is a GameMaker pr_* constant (pr_pointlist / pr_linelist /
// pr_linestrip / pr_trianglelist / pr_trianglestrip). pr_trianglefan is
// accepted but rejected with an error, because the backend has no equivalent
// topology and silently drawing something else would be worse.
//
// `first_vertex` and `vertex_count` select a range of the bound buffer.
// Pass vertex_count = -1 to draw to the end of the buffer.
//
// The caller is responsible for having set a shader and any render target.
// Returns true if the draw was issued.
// A state handle of 0 leaves that stage alone. `instance_buffer` 0 and
// `instance_count` 1 is a single draw. `instance_count` below 1 fails.
[global, bind = typed_gml]
function igpu_draw(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] instance_buffer,
    [type_hint = `uint64`] layout,
    primitive : int32,
    [type_hint = `int64`] first_vertex,
    [type_hint = `int64`] vertex_count,
    [type_hint = `int64`] instance_count,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// Draws using an index buffer as well. `index_count` is the number of indices,
// not the number of triangles. There is no instance parameter on this call.
[global, bind = typed_gml]
function igpu_draw_indexed(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] layout,
    [type_hint = `uint64`] index_buffer,
    primitive : int32,
    [type_hint = `int64`] first_index,
    [type_hint = `int64`] index_count,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// Draws from an argument buffer instead of CPU counts. `args` was created
// with IgpuBufferBind.Indirect. `args_offset` is the byte where a 16-byte
// record starts: vertex count, instance count, first vertex, first instance.
// `instance_buffer` is 0 when the shader only needs the instance number.
[global, bind = typed_gml]
function igpu_draw_indirect(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] instance_buffer,
    [type_hint = `uint64`] layout,
    primitive : int32,
    [type_hint = `uint64`] args,
    [type_hint = `int64`] args_offset,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// Draws one or more patches. `control_points` is how many vertices make one
// patch, from 1 to 32. `vertex_count` must be a whole number of patches, or
// -1 to draw through the end of the buffer when that length is whole.
// A hull shader and a domain shader must already be bound. The previous
// assembler state is put back before return. On a backend that stores the
// patch size as device state rather than in the draw itself, that size is
// restored too.
[global, bind = typed_gml]
function igpu_draw_patch(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] layout,
    control_points : int32,
    [type_hint = `int64`] first_vertex,
    [type_hint = `int64`] vertex_count,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// Indexed form. The record is 20 bytes: index count, instance count, first
// index, base vertex, first instance.
[global, bind = typed_gml]
function igpu_draw_indexed_indirect(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] instance_buffer,
    [type_hint = `uint64`] layout,
    [type_hint = `uint64`] index_buffer,
    primitive : int32,
    [type_hint = `uint64`] args,
    [type_hint = `int64`] args_offset,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// ---------------------------------------------------------------------------
// Pipeline state objects
// ---------------------------------------------------------------------------
//
// Immutable objects applied for a single igpu_draw_with_state() /
// igpu_draw_indexed_with_state() call. Pass 0 for a stage to leave the
// device's current setting alone. The previous blend, depth, rasteriser and
// sampler settings are put back before the call returns.
//
// That restore is required. GameMaker caches these and will not re-apply them
// on its next draw unless its own shadow copy is dirty. Unlike the input
// assembler, leaving one of these bound would change GameMaker's drawing.
//
// Factors, comparisons, cull modes, stencil ops and filters are GameMaker's
// own constants: bm_*, bm_eq_*, cmpfunc_*, cull_*, stencilop_*, tf_*.
// `repeat` matches gpu_set_texrepeat (true repeats, false clamps).

// `write_*` are the four channels, matching gpu_set_colourwriteenable.
// Returns a handle, or 0 on failure.
[global, bind = typed_gml]
function igpu_blend_state_create(
    enabled : bool,
    src : int32,
    dest : int32,
    equation : int32,
    src_alpha : int32,
    dest_alpha : int32,
    equation_alpha : int32,
    write_red : bool,
    write_green : bool,
    write_blue : bool,
    write_alpha : bool) : int64;

// Depth test plus stencil. Stencil arguments are validated even when stencil
// is disabled, so a bad constant is reported rather than stored.
[global, bind = typed_gml]
function igpu_depth_state_create(
    depth_test : bool,
    depth_write : bool,
    depth_func : int32,
    stencil_enable : bool,
    stencil_func : int32,
    stencil_fail : int32,
    stencil_depth_fail : int32,
    stencil_pass : int32,
    stencil_ref : int32,
    stencil_read_mask : int32,
    stencil_write_mask : int32) : int64;

// `fill` is IgpuFill. Scissor uses the rectangle already set on the device
// (GameMaker's viewport sets one). `depth_clip` drops fragments outside the
// depth range.
[global, bind = typed_gml]
function igpu_raster_state_create(
    cull : int32,
    fill : int32,
    scissor : bool,
    depth_clip : bool) : int64;

// One sampler. magnification, minification and mip are tf_point or tf_linear.
// anisotropy is 1..16. Above 1, all three filters must be tf_linear.
// address_* is IgpuAddressMode. border is an opaque GameMaker colour and is
// used only when an axis is Border. compare 0 is an ordinary sample. 1..8 is
// cmpfunc_* (cmpfunc_never is 1). Comparison together with Border fails.
// level_offset is a number of levels; positive is coarser. finest is the
// minimum level, 0 is the base. coarsest below 0 means no upper limit.
// The offset applies to samples that let the sampler choose the level, and
// on Direct3D 11 it also applies to SampleCmpLevelZero. Either way the
// chosen level stays inside the finest and coarsest limits.
[global, bind = typed_gml]
enum IgpuAddressMode
{
    Clamp = 0,
    Repeat = 1,
    Mirror = 2,
    Border = 3
}

[global, bind = typed_gml]
function igpu_sampler_state_create(
    magnification : int32,
    minification : int32,
    mip : int32,
    address_u : int32,
    address_v : int32,
    address_w : int32,
    anisotropy : int32,
    border : int32,
    compare : int32,
    level_offset : float,
    finest : float,
    coarsest : float) : int64;

[global, bind = typed_gml]
function igpu_state_release([type_hint = `uint64`] state) : bool;

// ---------------------------------------------------------------------------
// Textures
// ---------------------------------------------------------------------------

// kind is IgpuTextureKind. depth is 1 for TwoD, the slice count for ThreeD,
// the layer count for Array, and 6 for Cube (which must be square).
// Face 0 is +X, then -X, +Y, -Y, +Z, -Z.
// mip_count 1 is a single level. 0 allocates the full chain down to 1x1.
// Any other count must be from 1 to that chain. A chain can be a render target.
// storage allocates a texture a compute shader can write. One level only when
// storage is true is allowed; a chain may also be storage when the backend
// accepts it. Platforms without writable images fail this flag cleanly.
[global, bind = typed_gml]
function igpu_texture_create(
    kind : int32,
    width : int32,
    height : int32,
    depth : int32,
    format : int32,
    render_target : bool,
    storage : bool,
    mip_count : int32) : int64;

[global, bind = typed_gml]
function igpu_texture_generate_mips([type_hint = `uint64`] texture) : bool;

// Reads one surface_rgba8unorm pixel. Alpha is dropped, matching surface_getpixel.
// layer selects a slice or cube face. mip selects the level.
[global, bind = typed_gml]
function igpu_texture_read(
    [type_hint = `uint64`] texture,
    x : int32,
    y : int32,
    layer : int32,
    mip : int32) : int64;

[global, bind = typed_gml]
function igpu_texture_release([type_hint = `uint64`] texture) : bool;

// ---------------------------------------------------------------------------
// Compute
// ---------------------------------------------------------------------------

[global, bind = typed_gml]
enum IgpuWriteTarget
{
    Texture = 0,
    Buffer = 1
}

// kinds, targets, layers and mips are the same length, from 1 to 8.
// Slot i is that entry. A buffer entry must have layer 0 and mip 0.
// A texture entry's mip selects the level. The view covers every slice of
// that level; the shader chooses the slice. A texture entry's layer must be 0.
// The same texture or buffer cannot be listed twice. Slots are restored.
// Group counts are work groups, from 1 to 65535.
[global, bind = typed_gml]
function igpu_dispatch(
    groups_x : int32,
    groups_y : int32,
    groups_z : int32,
    kinds : array,
    targets : array,
    layers : array,
    mips : array) : bool;

// ---------------------------------------------------------------------------
// Queries and fences
// ---------------------------------------------------------------------------

[global, bind = typed_gml]
enum IgpuQueryKind
{
    Occlusion = 0,
    Timestamp = 1
}

[global, bind = typed_gml]
function igpu_query_create(kind : int32) : int64;

[global, bind = typed_gml]
function igpu_query_begin([type_hint = `uint64`] query) : bool;

[global, bind = typed_gml]
function igpu_query_end([type_hint = `uint64`] query) : bool;

[global, bind = typed_gml]
function igpu_query_ready([type_hint = `uint64`] query) : bool;

[global, bind = typed_gml]
function igpu_query_result([type_hint = `uint64`] query) : int64;

[global, bind = typed_gml]
function igpu_query_release([type_hint = `uint64`] query) : bool;

[global, bind = typed_gml]
function igpu_timestamp_frequency() : int64;

[global, bind = typed_gml]
function igpu_fence_create() : int64;

[global, bind = typed_gml]
function igpu_fence_signal([type_hint = `uint64`] fence) : bool;

[global, bind = typed_gml]
function igpu_fence_signaled([type_hint = `uint64`] fence) : bool;

[global, bind = typed_gml]
function igpu_fence_release([type_hint = `uint64`] fence) : bool;

// ---------------------------------------------------------------------------
// Draw targets and sampling
// ---------------------------------------------------------------------------

// targets, layers and mips are the same length, from 1 to 4.
// A 2D level-0 draw puts the texture in targets and 0 in layers and mips.
// State handles of 0 leave that stage alone.
[global, bind = typed_gml]
function igpu_draw_to_render_targets(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] layout,
    primitive : int32,
    [type_hint = `int64`] first_vertex,
    [type_hint = `int64`] vertex_count,
    targets : array,
    layers : array,
    mips : array,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;

// Samples `texture` from slot 0. texture 0 fails. The previous texture binding
// is put back before return. sampler_state 0 leaves the sampler alone.
[global, bind = typed_gml]
function igpu_draw_sampled(
    [type_hint = `uint64`] vertex_buffer,
    [type_hint = `uint64`] layout,
    primitive : int32,
    [type_hint = `int64`] first_vertex,
    [type_hint = `int64`] vertex_count,
    [type_hint = `uint64`] texture,
    [type_hint = `int64`] blend_state,
    [type_hint = `int64`] depth_state,
    [type_hint = `int64`] raster_state,
    [type_hint = `int64`] sampler_state) : bool;
// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Texture shapes shared by the backends. Not every backend implements every
// shape; ask igpu_supports before using ThreeD, Array, or Cube.
[global, bind = typed_gml]
enum IgpuTextureKind
{
    TwoD = 0,
    ThreeD = 1,
    Array = 2,
    Cube = 3
}

// Fill mode for igpu_raster_state_create. GameMaker has no constant for this.
[global, bind = typed_gml]
enum IgpuFill
{
    Solid = 0,
    Wireframe = 1
}

[global, bind = typed_gml]
enum IgpuFeatureLevel
{
    Unknown = 0,
    Level_11_0 = 1,
    Level_11_1 = 2,
    Level_12_0 = 3,
    Level_12_1 = 4
}

// Shader stages are a backend-neutral concept: every graphics API has a
// vertex and a fragment/pixel stage. The later entries are declared so the
// interface does not have to change when a backend that supports them is
// added - query igpu_supports() before use, do not assume.
//
//   D3D11 (Windows)  Vertex, Pixel, Geometry, Hull, Domain
//   D3D12 (Xbox)     all of the above plus Mesh, Amplification
//   OpenGL           Vertex, Pixel, Geometry, Hull(=tess control), Domain
//   Vulkan/Metal     all of the above (Hull=tesc, Domain=tese)
//   WebGL / GLES     Vertex, Pixel only
[global, bind = typed_gml]
enum IgpuShaderStage
{
    Vertex = 0,
    Pixel = 1,
    Compute = 2,
    Geometry = 3,
    Hull = 4,
    Domain = 5,
    Mesh = 6,
    Amplification = 7
}

// How often a buffer's contents change. This is deliberately NOT GameMaker's
// buffer_fixed / buffer_grow / buffer_wrap: those describe a CPU buffer's
// size-growth policy, whereas this describes how the GPU will be asked to
// store the data. Reusing the GM names here would silently mean something
// different, so these are separate.
//
// The backend translates these into its own memory-placement terms; callers
// never see them.
[global, bind = typed_gml]
enum IgpuBufferUsage
{
    // Written once at creation, then only read by the GPU. The backend is free
    // to place this in the fastest memory it has.
    Static = 0,

    // Rewritten frequently. Correct for anything updated every frame; the
    // backend keeps it CPU-writable.
    Dynamic = 1,

    // Readable back by the CPU. Never usable directly by a draw call, and read
    // back with igpu_buffer_read().
    Staging = 2
}

// What a buffer is allowed to be used for. Combine with bitwise OR, e.g.
// IgpuBufferBind.Vertex | IgpuBufferBind.Index for a shared geometry buffer.
//
// These are capability-deciding bits, so they are validated at creation: a
// buffer that claims a use the backend cannot honour fails loudly instead of
// producing a draw that silently renders nothing.
[global, bind = typed_gml]
enum IgpuBufferBind
{
    None = 0,
    Vertex = 1,
    Index = 2,
    Uniform = 4,
    Storage = 8,

    // Holds draw arguments, not vertices. The record is four unsigned values
    // for igpu_draw_indirect (vertex count, instance count, first vertex,
    // first instance) or five for igpu_draw_indexed_indirect (index count,
    // instance count, first index, base vertex, first instance). The same
    // record is what the other backends read. Do not combine this with
    // another bind flag. Create it with IgpuBufferUsage.Static.
    Indirect = 16
}

// How a vertex range is assembled into primitives. These values mirror
// GameMaker's pr_* constants so a caller can pass the GML constant straight
// through; they were read back from the runtime rather than assumed to follow
// the documented alphabetical order.
//
//   PrTriangleFan has no backend equivalent and is rejected by igpu_draw()
//   rather than silently drawn as something else.
[global, bind = typed_gml]
enum IgpuPrimitive
{
    PointList = 1,
    LineList = 2,
    LineStrip = 3,
    TriangleList = 4,
    TriangleStrip = 5,
    TriangleFan = 6
}

// Backend-neutral feature flags for igpu_supports(). Values are stable and
// must not be renumbered once shipped.
[global, bind = typed_gml]
enum IgpuCapability
{
    None = 0,

    // Shader compilation and stages
    ShaderCompileRuntime = 1,
    ShaderStageVertex = 2,
    ShaderStagePixel = 3,
    ShaderStageCompute = 4,
    ShaderStageGeometry = 5,
    ShaderStageTessellation = 6,
    ShaderStageMesh = 7,

    // Resources
    Texture3D = 20,
    TextureArray = 21,
    TextureCubemap = 22,
    StructuredBuffer = 23,
    UnorderedAccess = 24,
    MultipleRenderTargets = 25,
    Texture2D = 26,

    // Pipeline features
    Instancing = 40,
    IndirectDraw = 41,
    Queries = 42,
    Timestamps = 43,
    OcclusionQuery = 44,
    Fence = 45,
    Wireframe = 46,

    // Geometry submission
    InputLayout = 47,
    VertexBuffer = 48,
    IndexBuffer = 49,
    UniformBuffer = 50,
    // Buffer update strategies, queried so callers can pick one that works
    BufferResize = 51,
    BufferReadback = 52,

    // Drawing
    Draw = 53,
    DrawIndexed = 54,
    // Whether IGPU can restore GameMaker's input-assembler state after a draw.
    // False would mean drawing is unsafe to interleave with GM's own.
    DrawStateRestore = 55,

    // Immutable pipeline state objects applied for one draw, then restored.
    BlendState = 56,
    DepthState = 57,
    RasterState = 58,
    SamplerState = 59,

    // Platform info availability
    AdapterInfo = 60,
    VideoMemory = 61,
    BackbufferSize = 62,

    // The compiled shader can be asked for its uniform-block layout, and a
    // uniform buffer can be filled by member name.
    UniformReflection = 63
}
